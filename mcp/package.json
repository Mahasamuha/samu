{
  "name": "assistant-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for the assistant's remote tools (web search); reached only through the auth gateway.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit && tsc -p test --noEmit",
    "test": "rm -rf build-test && tsc -p test && node --test \"build-test/test/**/*.test.js\"",
    "start": "node dist/index.js",
    "lint": "oxlint --type-aware src test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
