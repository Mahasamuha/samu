{
  // Compiles src and test together so tests run as plain JS (type stripping can't handle this codebase).
  // The production build (tsconfig.json) never sees tests.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "build-test",
    "noEmit": false
  },
  "include": ["src", "test"]
}
