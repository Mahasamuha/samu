# Style for the app's Kotlin sources, enforced by ktlint (`./gradlew ktlintCheck`). Scoped to app/ because
# the TypeScript build units are formatted by Prettier, which reads its own config.
[*.{kt,kts}]
ktlint_code_style = ktlint_official

# Composable functions are PascalCase nouns by the Compose API guidelines, which the standard function-naming
# rule would flag. This is the documented compose-rules setup.
ktlint_function_naming_ignore_when_annotated_with = Composable
