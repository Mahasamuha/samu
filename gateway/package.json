{
  "name": "assistant-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Auth gateway: validates identity-provider JWTs and forwards chat completions to the LLM gateway.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "rm -rf build-test && tsc -p tsconfig.test.json && node --test \"build-test/test/**/*.test.js\"",
    "start": "node dist/index.js",
    "lint": "eslint src test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1"
  }
}
